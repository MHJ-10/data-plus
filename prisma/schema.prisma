// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum AnalysisStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ColumnType {
  NUMBER
  BOOLEAN
  DATE
  TEXT
  CATEGORY
  ID_LIKE
}

enum ColumnRole {
  DIMENSION
  MEASURE
  TEMPORAL
  IGNORE
}

enum ChartCategory {
  RECTANGULAR
  TREND
  CIRCULAR
  DISTRIBUTION
}

enum InsightType {
  TREND
  INSIGHT
  WARNING
  CORRELATION
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  password      String?
  emailVerified DateTime?  @map("email_verified")
  image         String?
  analyses      Analysis[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Analysis {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  datasetName String

  rowsCount    Int
  columnsCount Int

  status AnalysisStatus

  isFavorite Boolean @default(false)

  datasetPreview Json?

  originalFileName String?
  originalFileSize Int?

  analysisTimeMs Int?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charts         Chart[]
  insights       Insight[]
  columnMetadata ColumnMetadata[]

  @@index([userId])
  @@index([createdAt])
}

model Chart {
  id String @id @default(cuid())

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  title String

  category ChartCategory

  availableTypes Json

  xField String?
  yField String?

  score Float?

  chartData Json

  createdAt DateTime @default(now())

  @@index([analysisId])
}

model Insight {
  id String @id @default(cuid())

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  title String

  description String

  type InsightType

  score Float?

  createdAt DateTime @default(now())

  @@index([analysisId])
}

model ColumnMetadata {
  id String @id @default(cuid())

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  columnName String

  type ColumnType

  role ColumnRole

  missingCount Int

  uniqueCount Int

  uniqueRatio Float?

  averageLength Float?

  // Statistical properties
  mean Float?

  median Float?

  variance Float?

  stdDev Float?

  skewness Float?

  kurtosis Float?

  min Float?

  max Float?

  range Float?

  q1 Float?

  q3 Float?

  iqr Float?

  // Data quality metrics
  completeness Float?

  cardinalityRatio Float?

  hasOutliers Boolean?

  outlierCount Int?

  outlierPercentage Float?

  isSkewed Boolean?

  isNormal Boolean?

  dataDensity Float?

  createdAt DateTime @default(now())

  @@index([analysisId])
}
